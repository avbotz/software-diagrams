vars: {
  d2-config: {
    layout-engine: elk
    # https://d2lang.com/tour/themes/
    # Default
    theme-id: 0
    # Dark mauve
    dark-theme-id: 200
    pad: 24
  }
}

classes: {
  # Style used by thalassic/_devices.d2
  # Here so _devices doesn't need to be important at the root
  device: {style.3d: true}
}
